# Copy this file to .env and adjust as needed for local development.

# Comma-separated list of checkers to run.
ENABLED_CHECKS=check_host

# How long (seconds) each hostname's result is cached before re-checking.
# 0 disables caching (default). Only useful set longer than refreshInterval.
CACHE_TTL_SECONDS=0

# Python logging level. Use DEBUG for full HTTP request/response tracing.
LOG_LEVEL=INFO

# Number of check-host.net nodes checked per request.
CHECK_HOST_MAX_NODES=3
